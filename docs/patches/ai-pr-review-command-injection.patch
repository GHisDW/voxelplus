-            echo "mode=${{ inputs.mode }}" >> "$GITHUB_OUTPUT"
+          if [ "$EVENT_NAME" = "workflow_dispatch" ]; then
+            # Only digits are accepted; anything else would reach `gh api`.
+            if ! [[ "$INPUT_PR_NUMBER" =~ ^[0-9]{1,10}$ ]]; then
+              echo "Invalid pull request number." >&2
+              exit 1
+            fi
+
+            case "$INPUT_MODE" in
+              review|changed|security|tests) MODE="$INPUT_MODE" ;;
+              *) echo "Invalid review mode." >&2; exit 1 ;;
