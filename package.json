{
  "name": "voxelplus-launcher",
  "version": "1.1.0",
  "description": "V+ — Modern Minecraft development & mod-testing launcher for Fabric Loom and Gradle",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/GHisDW/voxelplus.git"
  },
  "keywords": [
    "minecraft",
    "fabric-loom",
    "gradle",
    "mod-launcher",
    "voxelplus",
    "minecraft-client",
    "singleplayer"
  ],
  "author": "GHisDW <voxelplusstudio@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GHisDW/voxelplus/issues"
  },
  "homepage": "https://github.com/GHisDW/voxelplus#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "app:dev": "vite",
    "start": "electron .",
    "test": "vitest run",
    "catalog:build": "node tools/generate-catalog-vpacks.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.voxelplus.launcher",
    "productName": "V+ Launcher",
    "directories": {
      "output": "dist-portable"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "vpacks/**/*",
      "logo.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "logo.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VoxelPlus-Portable-${version}.${ext}"
    }
  }
}
