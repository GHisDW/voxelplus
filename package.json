{
  "name": "voxelplus-launcher",
  "version": "1.1.1",
  "description": "Voxel+ — a Windows Minecraft instance launcher for Fabric, Quilt, Forge, and NeoForge",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/GHisDW/voxelplus.git"
  },
  "keywords": [
    "minecraft",
    "fabric-loom",
    "gradle",
    "mod-launcher",
    "voxelplus",
    "minecraft-client",
    "singleplayer"
  ],
  "author": "GHisDW <voxelplusstudio@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GHisDW/voxelplus/issues"
  },
  "homepage": "https://github.com/GHisDW/voxelplus#readme",
  "scripts": {
    "dev": "vite",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "app:dev": "npm run electron:compile && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --enable-logging\"",
    "start": "electron .",
    "test": "vitest run",
    "catalog:build": "node tools/generate-catalog-vpacks.mjs",
    "dist": "npm run build && electron-builder --win --x64 --config.win.target=nsis --config.directories.output=dist-installer",
    "dist:portable": "npm run build && electron-builder --win --x64 --config.win.target=portable --config.directories.output=dist-portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.voxelplus.launcher",
    "productName": "Voxel+ Launcher",
    "executableName": "VoxelPlus",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "vpacks/**/*",
      "logo.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "VoxelPlus-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voxel+ Launcher"
    },
    "portable": {
      "artifactName": "VoxelPlus-Portable-${version}.${ext}"
    }
  }
}
