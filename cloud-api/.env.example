# Voxel+ Cloud API — server-side configuration (NEVER shipped to clients).
#
# DATA BACKEND
#   Memory mode is explicit and intended only for local development/tests.
#   Production must use VOXELPLUS_DATA_BACKEND=supabase plus both Supabase values.
VOXELPLUS_DATA_BACKEND=memory
#
#   Production persistence (Postgres + Storage):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# TENANTSCALE (infrastructure: audit stream + IP signup rate limit).
#   Uses the same Supabase project; optional — local fallbacks apply
#   when absent. Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
VOXELPLUS_TENANT_ID=00000000-0000-0000-0000-000000000001
#
# OWNER BOOTSTRAP — comma-separated usernames granted the 'owner' role by
# the server during device registration/username claim.
VOXELPLUS_OWNER_USERNAMES=
#
# REWARDED ADS — provider selected via registry; without one, ad
# acquisition stays unavailable (POST /api/ads/complete → 503).
VOXELPLUS_AD_PROVIDER=
#
PORT=3001
