# Local development needs no .env file. `npm run dev` uses SQLite at
# data/voxelplus.sqlite and initializes the schema automatically.

# Production only:
VOXELPLUS_DATA_BACKEND=postgres
DATABASE_URL=postgresql://server-only-user:password@host/database?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10
PORT=3001

# Optional platform identity and bootstrap settings.
VOXELPLUS_TENANT_ID=voxelplus-platform
VOXELPLUS_OWNER_USERNAMES=owner_username
